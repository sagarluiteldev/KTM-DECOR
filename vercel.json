{
  "version": 2,
  "regions": ["bom1"],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "dashboard/backend/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dashboard/backend/src/inventorySeed.json"]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat"
    },
    {
      "src": "/api/revalidate",
      "dest": "/api/revalidate"
    },
    {
      "src": "/api/(.*)",
      "dest": "dashboard/backend/src/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
